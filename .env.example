# ==============================================================================
# Indian IPO Intelligence & Notification System - Environment Configuration
# ==============================================================================

# Application Environment: development, staging, production
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Database Configuration (Defaults to zero-cost local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./ipo_system.db
# PostgreSQL Alternative: postgresql+asyncpg://user:password@localhost:5432/ipo_db

# Web Server Configuration
PORT=8000
HOST=0.0.0.0

# Alert Timing & Scheduling (in calendar days / hours)
T_MINUS_DAYS_TARGET=2
REMINDER_HOURS_AFTER_ALERT=6
FINAL_REMINDER_DAYS_BEFORE=1
ENABLE_AUTOMATED_SCHEDULER=true

# Scoring Model Weights (Must sum to 1.0)
WEIGHT_BUSINESS_QUALITY=0.20
WEIGHT_FINANCIAL_QUALITY=0.20
WEIGHT_MANAGEMENT_GOVERNANCE=0.10
WEIGHT_IPO_STRUCTURE=0.10
WEIGHT_VALUATION=0.20
WEIGHT_GROWTH_INDUSTRY=0.10
WEIGHT_RISK=0.05
WEIGHT_MARKET_SENTIMENT=0.05

# Hard Assessment Thresholds
MIN_DATA_COMPLETENESS_RATIO=0.70
MAX_PERMISSIBLE_CONFLICTS=0

# Primary Notification: WhatsApp (Official Cloud API / Twilio)
# Set ENABLE_WHATSAPP=false to use Email or Console without any paid account
ENABLE_WHATSAPP=false
WHATSAPP_PROVIDER=console # options: cloud_api, twilio, console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_PHONE=+919876543210
# For Twilio WhatsApp:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Secondary Notification: Email (SMTP / Resend / Brevo)
ENABLE_EMAIL=false
EMAIL_PROVIDER=smtp # options: smtp, resend, console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=alerts@ipointelligence.local
EMAIL_TO=investor@example.com

# Backup Notification: SMS (Optional)
ENABLE_SMS=false
SMS_PROVIDER=console # options: twilio, console
SMS_RECIPIENT_PHONE=+919876543210

# YouTube API (Optional: Free quota 10,000 units/day; Fallback search used if empty)
YOUTUBE_API_KEY=

# Storage Directory for Ingested Documents & PDF Forensics
DOCUMENT_STORAGE_DIR=./storage/documents
SNAPSHOT_STORAGE_DIR=./storage/snapshots
